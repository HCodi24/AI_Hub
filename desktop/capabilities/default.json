{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Giao diện web cục bộ của MutiS có thể điều khiển cửa sổ (thu nhỏ, phóng to, đóng, kéo), đặt huy hiệu và nhấp nháy trên thanh tác vụ, cũng như kiểm tra và cài đặt bản cập nhật.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-icon",
    "core:window:allow-request-user-attention",
    "allow-update-check",
    "allow-update-install"
  ]
}
