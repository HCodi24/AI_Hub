{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Hub",
  "mainBinaryName": "AI Hub",
  "version": "0.1.0",
  "identifier": "com.hcodi24.aihub",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HCodi24",
    "shortDescription": "AI Hub",
    "longDescription": "AI Hub — điều phối Codex, Claude và DeepSeek trên máy của bạn.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../target/release/ai-hub.exe": "ai-hub.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
